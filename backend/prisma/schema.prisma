generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String?        @map("password_hash")
  role              Role
  createdAt         DateTime       @default(now()) @map("created_at")
  courses           Course[]       @relation("TutorCourses")
  bookings          Booking[]
  forumMessages     ForumMessage[]
  notifications     Notification[]
  reviewsGiven      Review[]       @relation("StudentReviews")
  materialsUploaded Material[]     @relation("TutorMaterials")

  @@map("users")
}

model Course {
  id            String         @id @default(uuid())
  title         String
  description   String?
  price         Int            @default(0)
  category      String         @default("Académico")
  activo        Boolean        @default(true)
  tutorId       String?        @map("tutor_id")
  tutor         User?          @relation("TutorCourses", fields: [tutorId], references: [id], onDelete: SetNull)
  tutorias      Tutoria[]
  bookings      Booking[]
  forumMessages ForumMessage[]
  materials     Material[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("courses")
}

model Tutoria {
  id          String          @id @default(uuid())
  courseId    String          @map("course_id")
  title       String
  description String?
  date        DateTime
  maxStudents Int             @default(10) @map("max_students")
  status      TutoriaStatus   @default(active)
  modality    TutoriaModality @default(presencial)
  location    String?         // Ej: "Aula 302 - Campus Central"
  meetingUrl  String?         @map("meeting_url") // Ej: "https://meet.google.com/xyz"
  createdAt   DateTime        @default(now()) @map("created_at")

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@map("tutorias")
}

model Booking {
  id          String        @id @default(uuid())
  studentId   String        @map("student_id")
  courseId    String        @map("course_id")
  tutoriaId   String?       @map("tutoria_id")
  scheduledAt DateTime      @map("scheduled_at")
  status             BookingStatus @default(pending)
  receiptUrl         String?       @map("receipt_url")
  cancelledBy        String?       @map("cancelled_by")
  cancellationReason String?       @map("cancellation_reason")
  createdAt          DateTime      @default(now()) @map("created_at")

  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutoria Tutoria? @relation(fields: [tutoriaId], references: [id], onDelete: SetNull)

  @@map("bookings")
}

model ForumMessage {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  userId    String   @map("user_id")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("forum_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(info)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id        String   @id @default(uuid())
  tutoriaId String   @map("tutoria_id")
  studentId String   @map("student_id")
  rating    Int      // 1 a 5 estrellas
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  tutoria Tutoria @relation(fields: [tutoriaId], references: [id], onDelete: Cascade)
  student User    @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutoriaId, studentId])
  @@map("reviews")
}

model Material {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  uploadedById String   @map("uploaded_by_id")
  title        String
  description  String?
  fileUrl      String   @map("file_url")
  fileType     String   @default("pdf") @map("file_type") // pdf, slide, doc, link
  createdAt    DateTime @default(now()) @map("created_at")

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("TutorMaterials", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("materials")
}

enum Role {
  student
  tutor
  admin
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum TutoriaStatus {
  active
  completed
  cancelled
}

enum NotificationType {
  info
  reminder
  booking_update
  forum_reply
}

enum TutoriaModality {
  presencial
  virtual
  hibrida
}

