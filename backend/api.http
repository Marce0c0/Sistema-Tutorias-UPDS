### ==============================================================================
### SISTEMA DE TUTORÍAS Y CURSOS UNIVERSITARIOS (UPDS) - REST CLIENT SUITE
### Base URL: Servidor Express Backend (Seguridad, Auth JWT, RBAC & Docker)
### ==============================================================================

@baseUrl = http://localhost:3001
@contentType = application/json

### ------------------------------------------------------------------------------
### 0. SALUD DE LA API / ROOT & CABECERAS DE SEGURIDAD
### ------------------------------------------------------------------------------

# @name getRoot
GET {{baseUrl}}/
Accept: {{contentType}}


### ==============================================================================
### 0.1 MÓDULO DE AUTENTICACIÓN Y SEGURIDAD JWT (/api/auth)
### ==============================================================================

# @name loginAdmin
# 1. Login exitoso como Administrador (obtiene JWT con rol admin)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@upds.edu.bo",
  "password": "Upds2026!"
}

### Guardar token de respuesta (ejecutar antes de pruebas RBAC)
@adminToken = {{loginAdmin.response.body.token}}

###

# @name loginTutor
# 2. Login exitoso como Tutor
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "maria@tutor.com",
  "password": "Upds2026!"
}

@tutorToken = {{loginTutor.response.body.token}}

###

# @name loginStudent
# 3. Login exitoso como Estudiante
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "juan@estudiante.com",
  "password": "Upds2026!"
}

@studentToken = {{loginStudent.response.body.token}}

###

# @name registerNewUser
# 4. Registro de un nuevo estudiante con validación y hash bcrypt
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "Carlos Gomez",
  "email": "carlos.gomez@estudiante.upds.edu.bo",
  "password": "Password2026!",
  "role": "student"
}

###

# @name getMeAuth
# 5. Obtener perfil de usuario autenticado mediante JWT activo
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name test401MissingToken
# 6. CASO NEGATIVO: 401 Unauthorized por falta de token JWT
GET {{baseUrl}}/api/users
Accept: {{contentType}}

###

# @name test401InvalidToken
# 7. CASO NEGATIVO: 401 Unauthorized por token corrupto o inválido
GET {{baseUrl}}/api/users
Authorization: Bearer token_falso_invalido_upds
Accept: {{contentType}}

###

# @name test403ForbiddenRole
# 8. CASO NEGATIVO: 403 Forbidden cuando un estudiante intenta crear un curso (requiere rol admin)
POST {{baseUrl}}/api/courses
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "title": "Curso No Autorizado",
  "description": "Intento de estudiante"
}

###

# @name test400ShortPassword
# 9. CASO NEGATIVO: 400 Bad Request por formato de contraseña inválido
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "Pedro Perez",
  "email": "pedro@upds.edu.bo",
  "password": "123",
  "role": "student"
}

###

# @name testSanitizationXSS
# 10. PRUEBA DE SEGURIDAD: Sanitización de inyecciones XSS en el payload
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "name": "Marta <script>alert('XSS')</script>",
  "email": "marta.xss@upds.edu.bo",
  "password": "SecurePassword2026!",
  "role": "student"
}


### ==============================================================================
### 1. USUARIOS (/api/users) - Requiere RBAC Admin/Tutor
### ==============================================================================

# @name getAllUsers
GET {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name getUserById
# Utiliza el ID generado en el seed para Juan Perez
@sampleUserId = fbedb367-859b-467b-a1bc-5ec7e37e7206
GET {{baseUrl}}/api/users/{{sampleUserId}}
Accept: {{contentType}}

###

# @name createUser
POST {{baseUrl}}/api/users
Content-Type: {{contentType}}

{
  "name": "Ana Rodriguez",
  "email": "ana.rodriguez@upds.edu.bo",
  "role": "student"
}

###

# @name updateUser
PUT {{baseUrl}}/api/users/{{sampleUserId}}
Content-Type: {{contentType}}

{
  "name": "Juan Perez Actualizado",
  "role": "student"
}

###

# @name deleteUser
DELETE {{baseUrl}}/api/users/{{sampleUserId}}
Accept: {{contentType}}


