# ==============================================================================
# Variables de Entorno de Ejemplo — Sistema-Tutoriales-UPDS
# NO subir archivos .env con credenciales reales a GitHub (.gitignore activo)
# ==============================================================================

PORT=3001
NODE_ENV=production

# --- Base de Datos PostgreSQL ---
# Opción 1: Supabase PostgreSQL (Free Tier $0.00 USD - Pooler IPv4)
DATABASE_URL="postgresql://postgres.[TU_PROYECTO]:[TU_PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Opción 2: AWS RDS PostgreSQL (si aplica)
# DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@[TU_HOST_RDS].us-east-2.rds.amazonaws.com:5432/postgres"

# Opción 3: Docker Local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@db:5432/tutorias_upds"

# --- Seguridad & JWT (Puntos 2, 4 y 6) ---
JWT_SECRET="tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# --- AWS Cloud Storage (S3) (Punto 13 - Free Tier) ---
AWS_REGION="us-east-2"
AWS_S3_BUCKET="sistema-tutorias-upds-prod"
AWS_S3_BUCKET_NAME="sistema-tutorias-upds-prod"
