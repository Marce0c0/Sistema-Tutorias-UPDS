# Variables de entorno — NO subir a GitHub (.gitignore)
# Copiar este archivo como .env y completar los valores reales

PORT=3001

# --- OPCIÓN 1: AWS RDS PostgreSQL ---
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@[TU_HOST_RDS].us-east-2.rds.amazonaws.com:5432/postgres"

# --- OPCIÓN 2: Supabase PostgreSQL (IPv4 Pooler Session) ---
# DATABASE_URL="postgresql://postgres.[TU_PROYECTO]:[TU_PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# --- AWS Cloud Storage (S3) ---
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="[TU_BUCKET_S3]"
